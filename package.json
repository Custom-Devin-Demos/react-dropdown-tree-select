{
  "name": "react-dropdown-tree-select",
  "version": "0.0.0-semantic-release",
  "description": "Lightweight, customizable and fast Dropdown Tree Select component for React",
  "keywords": [
    "react",
    "tree-select",
    "dropdown",
    "dropdown-tree-select",
    "react-dropdown-tree-select",
    "checkbox-tree",
    "checkbox-select",
    "checkbox-tree-select",
    "checkbox-dropdown-tree-select",
    "fast",
    "customizable",
    "lightweight",
    "searchable",
    "search"
  ],
  "main": "dist/react-dropdown-tree-select.js",
  "types": "dist/react-dropdown-tree-select.d.ts",
  "exports": {
    ".": {
      "types": "./dist/react-dropdown-tree-select.d.ts",
      "default": "./dist/react-dropdown-tree-select.js"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "default": "./dist/headless.js"
    },
    "./styles.css": "./dist/styles.css",
    "./dist/styles.css": "./dist/styles.css",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "headless": [
        "dist/headless.d.ts"
      ]
    }
  },
  "repository": "https://github.com/dowjones/react-dropdown-tree-select.git",
  "author": "Hrusikesh Panda <hrusikesh.panda@dowjones.com>",
  "license": "MIT",
  "scripts": {
    "build": "rimraf dist/**/* && cross-env NODE_ENV=production webpack --config webpack.config.js --bail --mode=production && yarn build:types",
    "build:types": "tsc -p tsconfig.build.json && node scripts/write-types-entry.js",
    "check-exports": "node scripts/check-exports.js",
    "build:docs": "yarn build && storybook build --quiet -o docs-dist",
    "commit": "git-cz",
    "coveralls": "yarn test && c8 report --reporter=text-lcov | coveralls",
    "demo": "yarn storybook",
    "prepublishOnly": "yarn build",
    "lint": "eslint --fix --ext .js,.jsx,.ts,.tsx src stories .storybook types-test webpack.config.js && stylelint --fix \"src/**/*.css\"",
    "lint:nofix": "eslint --ext .js,.jsx,.ts,.tsx src stories .storybook types-test webpack.config.js && stylelint \"src/**/*.css\"",
    "typecheck": "tsc -p tsconfig.json",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"types-test/**/*.{ts,tsx}\" \"stories/**/*.{js,jsx}\" \".storybook/**/*.js\" webpack.config.js",
    "test": "cross-env NODE_ENV=test c8 ava",
    "test:cov": "yarn test && c8 --reporter=lcov report",
    "test:watch": "cross-env NODE_ENV=test ava --watch",
    "bench": "cross-env NODE_ENV=test node -r ./setupBabel scripts/bench-100k.ts",
    "semantic-release": "semantic-release",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "contributors": "all-contributors add && all-contributors generate"
  },
  "files": [
    "dist/react-dropdown-tree-select.*",
    "dist/headless.*",
    "dist/styles.*",
    "dist/types",
    "headless",
    "MIGRATION.md"
  ],
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.12",
    "array.partial": "^1.0.5",
    "react-infinite-scroll-component": "^6.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.17.10",
    "@babel/plugin-proposal-class-properties": "^7.16.7",
    "@babel/plugin-syntax-jsx": "7.0.0-beta.46",
    "@babel/plugin-transform-runtime": "^7.17.10",
    "@babel/preset-env": "^7.17.10",
    "@babel/preset-react": "^7.16.7",
    "@babel/preset-typescript": "^7.23.0",
    "@babel/register": "^7.17.7",
    "@commitlint/cli": "^7.0.0",
    "@commitlint/config-conventional": "^7.0.0",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/addon-webpack5-compiler-babel": "^3.0.6",
    "@storybook/blocks": "8.6.14",
    "@storybook/react": "8.6.14",
    "@storybook/react-webpack5": "8.6.14",
    "@storybook/test": "8.6.14",
    "@testing-library/dom": "^9.3.4",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^18.0.0",
    "@types/prop-types": "^15.7.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/sinon": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "all-contributors-cli": "^5.4.1",
    "ava": "3",
    "axe-core": "^3.2.2",
    "babel-loader": "^8.2.5",
    "babel-plugin-istanbul": "4.1.3",
    "babel-plugin-transform-react-remove-prop-types": "0.4.13",
    "c8": "^7.11.2",
    "commitizen": "^2.9.6",
    "conventional-changelog-cli": "^2.0.5",
    "coveralls": "^3.0.0",
    "cross-env": "^5.0.5",
    "css-loader": "^0.28.0",
    "cz-conventional-changelog-emoji": "^0.1.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-prettier": "^4.2.1",
    "husky": "1.3.1",
    "ignore-styles": "^5.0.1",
    "jsdom": "^20.0.3",
    "jsdom-global": "^3.0.2",
    "lint-staged": "8.1.5",
    "mini-css-extract-plugin": "^2.7.2",
    "postcss": "^6.0.16",
    "postcss-cssnext": "^3.1.0",
    "postcss-import": "^11.0.0",
    "postcss-loader": "^2.0.10",
    "postcss-nested": "^3.0.0",
    "prettier": "^2.8.8",
    "prettier-stylelint": "^0.4.2",
    "prop-types": "^15.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^2.6.1",
    "sinon": "^5.0.0",
    "storybook": "8.6.14",
    "style-loader": "^0.20.1",
    "stylelint": "^9.0.0",
    "stylelint-config-standard": "^18.0.0",
    "typescript": "~5.1.6",
    "webpack": "^5.75.0",
    "webpack-bundle-analyzer": "^4.7.0",
    "webpack-cli": "^5.0.1",
    "why-did-you-update": "^0.1.1"
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0"
  },
  "ava": {
    "extensions": [
      "js",
      "ts",
      "tsx"
    ],
    "files": [
      "src/**/*.test.{ts,tsx}"
    ],
    "require": [
      "./setupBabel",
      "ignore-styles",
      "jsdom-global/register",
      "./setupTests"
    ],
    "snapshotDir": "__snapshots__",
    "serial": true,
    "timeout": "60s"
  },
  "stylelint": {
    "extends": "stylelint-config-standard"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "subject-case": [
        2,
        "always",
        "sentence-case"
      ]
    }
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog-emoji"
    }
  },
  "lint-staged": {
    "*.{js,json,css,md,ts,tsx}": [
      "prettier --write",
      "git add -f"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "release": {
    "comment": "This is for semantic-release configuration",
    "branches": [
      "main"
    ]
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
