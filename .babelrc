{
  "presets": [
    "@babel/preset-env",
    "@babel/preset-react",
    [
      "@babel/preset-typescript",
      {
        "allowDeclareFields": true
      }
    ]
  ],
  "env": {
    "test": {
      "presets": [
        "@babel/preset-env",
        "@babel/preset-react",
        [
          "@babel/preset-typescript",
          {
            "allowDeclareFields": true
          }
        ]
      ],
      "plugins": [
        "istanbul",
        [
          "@babel/plugin-transform-runtime"
        ]
      ]
    }
  }
}
